zinit cdreplay -q

# Prompt
eval "$(starship init zsh)"

# Keybindings
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'

# Aliases
alias ls='lsd -la'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'
alias vim='nvim'
alias cl='clear'
alias oc='opencode'

export VISION_MODE='subagent'
export VISION_SUBAGENT_NAME='observer'

unalias oc-sp 2>/dev/null

_oc_profile() {
  local profile="$1"
  local tui_profile="$2"
  shift 2

  command cp "$HOME/.config/opencode/profiles/$tui_profile" "$HOME/.config/opencode/tui.json" || return
  OPENCODE_CONFIG="$HOME/.config/opencode/profiles/$profile" opencode "$@"
}

oc-sp() { _oc_profile superpowers.json superpowers.tui.json "$@"; }

_oc_model_profile() {
  local profile="$1"
  local profile_path="$HOME/.config/opencode/profiles/$profile"
  shift

  OPENCODE_CONFIG_CONTENT="$(<"$profile_path")" opencode "$@"
}

oc-go() { _oc_model_profile models-opencode-go.json "$@"; }
oc-openai() { _oc_model_profile models-openai.json "$@"; }
oc-mixed() { _oc_model_profile models-mixed.json "$@"; }

# Shell integrations
eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"

. $HOMEBREW_PREFIX/etc/profile.d/z.sh




function cursor {
  open -a "/Applications/Cursor.app" "$@"
}

